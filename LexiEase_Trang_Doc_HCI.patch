diff --git a/frontend/src/screens/MinimalReadingView/reader-layout.css b/frontend/src/screens/MinimalReadingView/reader-layout.css
new file mode 100644
index 0000000000000000000000000000000000000000..5547e2bc898a2f47281deb80f4cc524cf606c40b
--- /dev/null
+++ b/frontend/src/screens/MinimalReadingView/reader-layout.css
@@ -0,0 +1,61 @@
+.reader-shell {
+  container: reader / inline-size;
+}
+.reader-sidebar {
+  --rail-width: 15rem;
+  width: var(--rail-width);
+  z-index: 30;
+}
+.reader-nav-item {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: .75rem;
+  min-height: 2.75rem;
+  width: 100%;
+  padding: .625rem .875rem;
+  border-radius: 1rem;
+  text-align: left;
+  color: #495974;
+}
+.reader-nav-item:hover { background: #f0eee9; }
+.reader-nav-item[aria-current="page"] { background: #e9edf7; color: #1556b8; font-weight: 600; }
+.reader-nav-item[aria-expanded="true"] { box-shadow: inset 0 0 0 1px #63718a; }
+.reader-shell :is(a, button, input, main):focus-visible {
+  outline: 2px solid #246aca;
+  outline-offset: 2px;
+  box-shadow: 0 0 0 2px white;
+}
+.reader-nav-short { display: none; }
+
+/* The query uses the reading font for ch. Reserve 15rem for full navigation,
+   9rem for page/card gutters and 22.75rem for the open settings column.
+   Measure against the entire shell to avoid oscillation when the rail shrinks. */
+@container reader (width < calc(45ch + 24rem)) {
+  .reader-sidebar { --rail-width: 3.5rem; }
+}
+@container reader (width < calc(45ch + 46.75rem)) {
+  .reader-sidebar[data-settings-open="true"] { --rail-width: 3.5rem; }
+}
+.reader-sidebar {
+  container: navigation / inline-size;
+}
+@container navigation (width < 8rem) {
+  .reader-brand-long, .reader-decoration, .reader-active-dot { display: none; }
+  .reader-nav-short { display: inline; }
+  .reader-brand, .reader-nav-item { justify-content: center; padding-inline: 0; }
+  .reader-nav-text { display: none; }
+  .reader-nav-item:is(:hover, :focus-visible) .reader-nav-text {
+    display: block;
+    position: absolute;
+    left: calc(100% + .5rem);
+    top: 50%;
+    transform: translateY(-50%);
+    width: max-content;
+    padding: .3rem .65rem;
+    border-radius: .45rem;
+    color: white;
+    background: #263750;
+    pointer-events: none;
+  }
+}
diff --git a/frontend/src/screens/MinimalReadingView/useReadingAnchor.ts b/frontend/src/screens/MinimalReadingView/useReadingAnchor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..18163a32c83707f218a391582e250d6243a7d631
--- /dev/null
+++ b/frontend/src/screens/MinimalReadingView/useReadingAnchor.ts
@@ -0,0 +1,78 @@
+import { useCallback, useLayoutEffect, useRef, type RefObject } from 'react';
+
+interface Anchor {
+  segment: HTMLElement;
+  start: string;
+  top: number;
+}
+
+// Record a visible word just before changing the document layout. The fixed
+// ruler owns scroll position while enabled; this hook serves ordinary reading.
+export function useReadingAnchor(
+  mainRef: RefObject<HTMLElement | null>,
+  bodyRef: RefObject<HTMLElement | null>,
+  rulerEnabled: boolean,
+) {
+  const pending = useRef<Anchor | null>(null);
+  const fontAnchor = useRef<Anchor | null>(null);
+  const preferred = useRef<HTMLElement | null>(null);
+
+  function rememberWord(target: EventTarget | null) {
+    if (target instanceof Element) {
+      const token = target.closest<HTMLElement>('[data-token-start]');
+      if (token) preferred.current = token;
+    }
+  }
+
+  const capture = useCallback(() => {
+    const main = mainRef.current;
+    const body = bodyRef.current;
+    pending.current = null;
+    fontAnchor.current = null;
+    if (rulerEnabled || !main || !body) return;
+    const viewport = main.getBoundingClientRect();
+    const visible = (node: HTMLElement) => {
+      const rect = node.getBoundingClientRect();
+      return rect.bottom > viewport.top && rect.top < viewport.bottom;
+    };
+    let token = preferred.current;
+    if (!token || !body.contains(token) || !visible(token)) {
+      if (main.scrollTop <= 0) return;
+      token = null;
+      for (const block of body.querySelectorAll<HTMLElement>('[data-segment-id]')) {
+        if (!visible(block)) continue;
+        token = Array.from(block.querySelectorAll<HTMLElement>('[data-token-start]')).find(visible) ?? null;
+        if (token) break;
+      }
+    }
+    const segment = token?.closest<HTMLElement>('[data-segment-id]');
+    if (segment && token?.dataset.tokenStart !== undefined) {
+      pending.current = { segment, start: token.dataset.tokenStart, top: token.getBoundingClientRect().top - viewport.top };
+    }
+  }, [bodyRef, mainRef, rulerEnabled]);
+
+  useLayoutEffect(() => {
+    const main = mainRef.current;
+    const anchor = pending.current;
+    pending.current = null;
+    if (rulerEnabled) fontAnchor.current = null;
+    if (!main || !anchor || rulerEnabled) return;
+    const restore = () => {
+      const word = anchor.segment.querySelector<HTMLElement>(`[data-token-start="${anchor.start}"]`);
+      if (!word || !main.contains(word)) return;
+      const delta = word.getBoundingClientRect().top - main.getBoundingClientRect().top - anchor.top;
+      if (Math.abs(delta) > 1) main.scrollTop += delta;
+    };
+    restore();
+    const scrollTop = main.scrollTop;
+    // Access geometry first so a font requested by this render is in the font set.
+    if (document.fonts.status === 'loading') {
+      fontAnchor.current = anchor;
+      void document.fonts.ready.then(() => {
+        if (fontAnchor.current === anchor && Math.abs(main.scrollTop - scrollTop) <= 1) restore();
+        if (fontAnchor.current === anchor) fontAnchor.current = null;
+      });
+    }
+  });
+  return { capture, rememberWord };
+}
