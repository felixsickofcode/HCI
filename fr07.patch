diff --git a/app/repositories/vocabulary_repository.py b/app/repositories/vocabulary_repository.py
new file mode 100644
index 0000000..65b0712
--- /dev/null
+++ b/app/repositories/vocabulary_repository.py
@@ -0,0 +1,64 @@
+from sqlalchemy import delete, func, select
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+
+from app.models.vocabulary import VocabularyEntry
+from app.schemas.vocabulary import VocabularyQuery
+
+
+class VocabularyRepository:
+    def __init__(self, db: Session):
+        self.db = db
+
+    def find_duplicate(self, user_id: int, key: str) -> VocabularyEntry | None:
+        return self.db.scalar(select(VocabularyEntry).where(
+            VocabularyEntry.user_id == user_id, VocabularyEntry.dedupe_key == key,
+        ))
+
+    def create(self, entry: VocabularyEntry) -> VocabularyEntry:
+        self.db.add(entry)
+        try:
+            self.db.commit()
+        except IntegrityError:
+            self.db.rollback()
+            raise
+        self.db.refresh(entry)
+        return entry
+
+    def list(self, user_id: int, query: VocabularyQuery, normalized_query: str):
+        conditions = [VocabularyEntry.user_id == user_id]
+        if normalized_query:
+            conditions.append(VocabularyEntry.normalized_term.contains(normalized_query, autoescape=True))
+        if query.source_document_id:
+            conditions.append(VocabularyEntry.source_document_id == query.source_document_id)
+        if query.from_date:
+            conditions.append(VocabularyEntry.created_at >= query.from_date)
+        if query.to_date:
+            conditions.append(VocabularyEntry.created_at < query.to_date)
+        total = self.db.scalar(select(func.count()).select_from(VocabularyEntry).where(*conditions))
+        items = list(self.db.scalars(select(VocabularyEntry).where(*conditions).order_by(
+            VocabularyEntry.created_at.desc(), VocabularyEntry.id.desc(),
+        ).offset(query.skip).limit(query.limit)))
+        return items, total
+
+    def sources(self, user_id: int):
+        return self.db.execute(select(
+            VocabularyEntry.source_document_id,
+            func.max(VocabularyEntry.source_title).label("source_title"),
+        ).where(
+            VocabularyEntry.user_id == user_id,
+            VocabularyEntry.source_document_id.is_not(None),
+        ).group_by(VocabularyEntry.source_document_id).order_by(
+            VocabularyEntry.source_document_id,
+        )).all()
+
+    def delete_one(self, user_id: int, entry_id: int) -> bool:
+        result = self.db.execute(delete(VocabularyEntry).where(
+            VocabularyEntry.user_id == user_id, VocabularyEntry.id == entry_id,
+        ))
+        self.db.commit()
+        return result.rowcount > 0
+
+    def delete_all(self, user_id: int) -> None:
+        self.db.execute(delete(VocabularyEntry).where(VocabularyEntry.user_id == user_id))
+        self.db.commit()
diff --git a/app/schemas/vocabulary.py b/app/schemas/vocabulary.py
new file mode 100644
index 0000000..c21de6c
--- /dev/null
+++ b/app/schemas/vocabulary.py
@@ -0,0 +1,91 @@
+from datetime import datetime
+from typing import Literal, Self
+
+from pydantic import AwareDatetime, ConfigDict, Field, field_validator, model_validator
+
+from app.schemas.base import CamelModel
+
+
+class VocabularyWrite(CamelModel):
+    # Reject forged owner/timestamp fields rather than silently accepting them.
+    model_config = ConfigDict(extra="forbid")
+    term: str = Field(min_length=1, max_length=120)
+    meaning: str | None = Field(default=None, max_length=2000)
+    example: str | None = Field(default=None, max_length=2000)
+    context_text: str = Field(min_length=1, max_length=4000)
+    source_document_id: str | None = Field(default=None, min_length=1, max_length=200)
+    source_title: str | None = Field(default=None, min_length=1, max_length=300)
+    source_kind: Literal["paste", "pdf", "image"] | None = None
+    content_version: str | None = Field(default=None, pattern=r"^[a-f0-9]{64}$")
+    segment_id: str | None = Field(default=None, min_length=1, max_length=100)
+    start: int | None = Field(default=None, ge=0, strict=True)
+    end: int | None = Field(default=None, ge=1, strict=True)
+
+    @field_validator("meaning", "example", mode="before")
+    @classmethod
+    def blank_optional_text(cls, value):
+        return (value.strip() or None) if isinstance(value, str) else value
+
+    @model_validator(mode="after")
+    def validate_selection(self) -> Self:
+        if not self.term.strip() or not self.context_text.strip():
+            raise ValueError("Từ và ngữ cảnh không được trống")
+        for value in self.model_dump().values():
+            if isinstance(value, str):
+                if "\x00" in value:
+                    raise ValueError("Văn bản chứa ký tự NUL không hợp lệ")
+                try:
+                    value.encode("utf-16-le")
+                except UnicodeEncodeError:
+                    raise ValueError("Văn bản chứa Unicode không hợp lệ") from None
+        if len(self.term.encode("utf-16-le")) // 2 > 120:
+            raise ValueError("Từ/cụm từ tối đa 120 ký tự UTF-16")
+        if len(self.context_text.encode("utf-16-le")) // 2 > 4000:
+            raise ValueError("Ngữ cảnh tối đa 4000 ký tự UTF-16")
+        coordinates = (self.segment_id, self.start, self.end)
+        if any(v is not None for v in coordinates):
+            if any(v is None for v in coordinates):
+                raise ValueError("segmentId, start và end phải được gửi cùng nhau")
+            encoded = self.context_text.encode("utf-16-le")
+            if self.start >= self.end or self.end * 2 > len(encoded):
+                raise ValueError("Vị trí từ nằm ngoài đoạn ngữ cảnh")
+            try:
+                selected = encoded[self.start * 2:self.end * 2].decode("utf-16-le")
+            except UnicodeDecodeError:
+                raise ValueError("Vị trí từ chia đôi ký tự Unicode") from None
+            if selected != self.term:
+                raise ValueError("Từ được lưu không khớp vị trí trong ngữ cảnh")
+        return self
+
+
+class VocabularyRead(VocabularyWrite):
+    model_config = ConfigDict(from_attributes=True)
+    id: int
+    created_at: datetime
+
+
+class VocabularyQuery(CamelModel):
+    q: str = Field(default="", max_length=120)
+    source_document_id: str | None = Field(default=None, max_length=200)
+    from_date: AwareDatetime | None = Field(default=None, alias="from")
+    to_date: AwareDatetime | None = Field(default=None, alias="to")
+    skip: int = Field(default=0, ge=0)
+    limit: int = Field(default=20, ge=1, le=100)
+
+    @model_validator(mode="after")
+    def validate_dates(self) -> Self:
+        if self.from_date and self.to_date and self.from_date >= self.to_date:
+            raise ValueError("Ngày kết thúc phải sau ngày bắt đầu")
+        return self
+
+
+class VocabularyPage(CamelModel):
+    items: list[VocabularyRead]
+    total: int
+    skip: int
+    limit: int
+
+
+class VocabularySource(CamelModel):
+    source_document_id: str
+    source_title: str
diff --git a/app/services/vocabulary_service.py b/app/services/vocabulary_service.py
new file mode 100644
index 0000000..93a0215
--- /dev/null
+++ b/app/services/vocabulary_service.py
@@ -0,0 +1,53 @@
+import hashlib
+import json
+import unicodedata
+
+from sqlalchemy.exc import IntegrityError
+
+from app.core.exceptions import NotFoundError
+from app.models.vocabulary import VocabularyEntry
+from app.repositories.vocabulary_repository import VocabularyRepository
+from app.schemas.vocabulary import VocabularyQuery, VocabularyWrite
+
+
+def normalize_text(value: str) -> str:
+    return " ".join(unicodedata.normalize("NFC", value).lower().split())
+
+
+class VocabularyService:
+    def __init__(self, repo: VocabularyRepository):
+        self.repo = repo
+
+    def save(self, user_id: int, data: VocabularyWrite) -> tuple[VocabularyEntry, bool]:
+        payload = data.model_dump()
+        normalized = normalize_text(data.term)
+        identity = [normalized, normalize_text(data.context_text), data.source_document_id,
+                    data.content_version, data.segment_id, data.start, data.end]
+        key = hashlib.sha256(json.dumps(identity, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+        existing = self.repo.find_duplicate(user_id, key)
+        if existing:
+            return existing, False
+        record = VocabularyEntry(user_id=user_id, normalized_term=normalized, dedupe_key=key, **payload)
+        try:
+            return self.repo.create(record), True
+        except IntegrityError:
+            # A concurrent request may have inserted this selection after our read.
+            existing = self.repo.find_duplicate(user_id, key)
+            if existing:
+                return existing, False
+            raise
+
+    def list(self, user_id: int, query: VocabularyQuery):
+        return self.repo.list(user_id, query, normalize_text(query.q))
+
+    def sources(self, user_id: int):
+        return [{"sourceDocumentId": row.source_document_id,
+                 "sourceTitle": row.source_title or "Tài liệu không có tên"}
+                for row in self.repo.sources(user_id)]
+
+    def delete(self, user_id: int, entry_id: int) -> None:
+        if not self.repo.delete_one(user_id, entry_id):
+            raise NotFoundError("Không tìm thấy từ đã lưu")
+
+    def clear(self, user_id: int) -> None:
+        self.repo.delete_all(user_id)
